# ESP32-WROOM-32U: 4 MB flash, no PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Nothing here uses Bluetooth, and leaving it out returns a large amount of
# both flash and RAM on a chip that has little of either.
CONFIG_BT_ENABLED=n

# The control channel is Noise over plain HTTP, so mbedTLS is not on the
# critical path. It stays in the build for now because DERP would need it.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# The chip will do 240 MHz; the default is 160. Curve25519 is the slowest
# thing we run and it scales straight with the clock.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Subnet routing: forward IP between the tunnel and the LAN, and masquerade
# so replies from LAN devices come back through this device.
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

# lwIP's own IP counters. Our tun counters say a packet arrived and was meant
# for the LAN; only these say whether the stack then actually put it on the
# wire (ip.fw), found nowhere to send it (ip.rterr), or threw it away
# (ip.drop). Without them "forwarded" is an assumption.
CONFIG_LWIP_STATS=y

# Updating over the tunnel: two app slots (see partitions.csv) and a
# bootloader that goes back to the previous image when a new one never
# confirms itself. A box where nobody can press reset must not be one bad
# image away from a car journey.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Per-task runtime counters, so the dashboard can show real CPU load rather
# than guessing from how busy things look.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# The default 512 bytes is enough for curl but not for an actual browser: a
# real POST from Chrome (sec-ch-ua/-mobile/-platform, Sec-Fetch-*, a full
# Referer, a long User-Agent) runs past it, and esp_http_server rejects the
# whole request with 431 before any handler runs - the language switch
# button's first real test failed this way. 512 had apparently always been
# marginal; nothing before this pushed a same-origin form POST hard enough
# to notice.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1536
